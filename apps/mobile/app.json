      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.livias.archive"
    },
    "extra": {
      "supabaseUrl": "https://your-project.supabase.co",
      "supabaseAnonKey": "your-anon-key",
      "apiUrl": "http://localhost:3333"
    }
  }
}
